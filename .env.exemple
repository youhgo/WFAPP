# REDIS
REDIS_URL=redis://redis:6379/0

WAZUH_HOST="https://wazuh.indexer"
WAZUH_PORT=9200
WAZUH_USER="admin"
WAZUH_PASSWD="SecretPassword"
WAZUH_TIMEOUT=120
WAZUH_MODE="streaming"
WAZUH_NBTHREAD=4
WAZUH_CHUNKSIZE=10000
WAZUH_VERIFYSSL=0

# ELK
ELK_HOST="localhost"
ELK_PORT=9200
ELK_USER="elastic"
ELK_PASSWD="changeme"
ES_VERIFYSSL=0
ES_CHUNKSIZE=500

# You can bind the host or ip you want, ex
# For exemple WAPP_API_HOST=10.10.10.10
# For exemple WAPP_API_HOST=wapp.your.domain
WAPP_API_HOST=wapp.localhost

#For exemple SECRET_KEY=b2c58a62319c5c7d0e515d9a9f4d1e2e6b0a1d4a5b7c8f9d
SECRET_KEY="very long random string"

# Bind the path to the share folder you want to use
# For exemple SHARED_FOLDER_PATH=/home/hro/Documents/shared
SHARED_FOLDER_PATH=/home/user/Documents/shared
BULK_DEPOT_FOLDER_PATH = "/home/user/Documents/shared/bulk_ingest"


#PROXY
HTTP_PROXY_URL=$(HTTP_PROXY)
HTTPS_PROXY_URL=$(HTTPS_PROXY)
PROXY_USER=$(PROXY_USER)
PROXY_USER_PWD=$(PROXY_USER_PWD)
NO_PROXY="localhost, 127.0.0.1"

# APP CONFIGURATION
WORKER_COUNT=1