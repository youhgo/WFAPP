# REDIS
REDIS_URL=redis://redis:6379/0

# Setup your elk param
ELK_HOST="https://elasticsearch"
ELK_PORT=9200
ELK_USER="elastic"
ELK_PASSWD="changeme"
ES_TIMEOUT=120
ES_MODE="parallel"
ES_NBTHREAD=4
ES_CHUNKSIZE=10000
ES_VERIFYSSL=0

WAZUH_HOST="https://192.168.1.120"
WAZUH_PORT=9200
WAZUH_USER="admin"
WAZUH_PASSWD="SecretPassword"
WAZUH_TIMEOUT=120
WAZUH_MODE="streaming"
WAZUH_NBTHREAD=4
WAZUH_CHUNKSIZE=10000
WAZUH_VERIFYSSL=0

# Setup your splunk param /!\ Splunk is not available for now
SPLUNK_HOST=x.x.x.x
SPLUNK_PORT=8089
SPLUNK_TOKEN="token"

# You can bind the host or ip you want, ex
# WAPP_API_HOST=10.37.36.217
# WAPP_API_HOST=wapp.your.domain
WAPP_API_HOST=wapp.localhost

# Bind the path to the share folder you want to use
# For exemple SHARED_FOLDER_PATH=/home/hro/Documents/shared
SHARED_FOLDER_PATH=/home/hro/Documents/shared

#PROXY
HTTP_PROXY_URL=$(HTTP_PROXY)
HTTPS_PROXY_URL=$(HTTPS_PROXY)
PROXY_USER=$(PROXY_USER)
PROXY_USER_PWD=$(PROXY_USER_PWD)